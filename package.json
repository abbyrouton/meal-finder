{
  "name": "meal-finder-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && go run main.go",
    "build": "cd frontend && npm run build",
    "build:backend": "cd backend && go build -o server main.go",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && go mod tidy"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
